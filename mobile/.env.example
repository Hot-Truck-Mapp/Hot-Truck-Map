# Copy to .env.local — Expo uses EXPO_PUBLIC_ prefix (not NEXT_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# From your EAS project dashboard: https://expo.dev
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# Required for Google Maps on Android (get from Google Cloud Console)
# Note: the shipped value lives in mobile/app.json under
# android.config.googleMaps.apiKey — no code reads this env var today.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Base URL the app calls for its own API routes (notify-followers, and the
# links out to signup and the dashboard). Defaults to https://hottruckmap.com
# when unset, so a dev build points at production data unless you set this.
EXPO_PUBLIC_API_URL=https://hottruckmap.com

# ── Mapbox ──────────────────────────────────────────────────
# Used by the operator tab's "enter address manually" fallback — the only
# way to go live after declining the location prompt. It was in no eas.json
# build profile, so that path was dead in every shipped build.
#
# ALREADY SET as an EAS project environment variable, for development,
# preview and production. Builds pick it up automatically — you do not need
# to do anything for a build. This entry is only for running locally.
#
# It is deliberately NOT in eas.json: GitHub push protection flags Mapbox
# tokens, so committing it there blocks the push. EAS environment variables
# live outside the repo, which is the right home for it anyway.
#
#   eas env:list --environment production        # confirm it is there
#   eas env:set --name EXPO_PUBLIC_MAPBOX_TOKEN --value pk.… \
#     --scope project --visibility plaintext --type string \
#     --environment development --environment preview --environment production
EXPO_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token
