# Normalize all text files to LF in the repo, regardless of OS.
# Prevents Windows checkouts (e.g. working on an HP) from re-introducing CRLF.
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.heic binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.mov binary
*.zip binary
*.aab binary
*.apk binary
*.ipa binary
*.jks binary
*.keystore binary
*.p8 binary
*.p12 binary
*.mobileprovision binary
