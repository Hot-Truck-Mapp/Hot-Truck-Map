# .env.example — commit this file to Git
# Copy to .env.local and fill in real values

NEXT_PUBLIC_SUPABASE_URL=https://ikrhlifpznzdtgxleubz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_MAPBOX_TOKEN=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Resend (transactional email) ────────────────────────────
# REQUIRED. Without it lib/email.ts sendEmail() logs a warning and returns
# { skipped: true } without throwing — so every caller "succeeds" and no
# error is ever surfaced. Two things go silently missing:
#   • the "New food truck signup" alert to info@hottruckmap.com
#     (app/api/signup/operator)
#   • the newsletter welcome email (app/api/newsletter-subscribe)
# Note that RESEND_FROM_EMAIL being set is not enough on its own.
RESEND_API_KEY=
# Optional override. Must use a verified domain in Resend.
RESEND_FROM_EMAIL=HotTruckMap <notifications@hottruckmap.com>

# Set to https://hottruckmap.com in production (Vercel env vars).
#
# NOTE: the variable the code actually reads is NEXT_PUBLIC_SITE_URL. This file
# previously documented NEXT_PUBLIC_APP_URL, which nothing has ever read — so
# setting it on a domain change would have had no effect. Used by app/robots.ts,
# app/sitemap.ts, the metadataBase in app/layout.tsx, and the unsubscribe links
# in newsletter emails. Every one falls back to https://hottruckmap.com, so
# nothing is broken today; it only matters if the domain changes.
NEXT_PUBLIC_SITE_URL=https://hottruckmap.com
NODE_ENV=development

# ── Web push (VAPID) ────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
# Without all three, /api/notifications can't send and follower
# broadcasts silently deliver to nobody.
VAPID_EMAIL=mailto:info@hottruckmap.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Internal service-to-service key ─────────────────────────
# /api/notify-followers calls /api/notifications with this header.
# /api/notifications fails closed with a 503 when it isn't set, so an
# unset value means follower push never sends. Any long random string.
INTERNAL_NOTIFY_KEY=

# ── Vercel Cron ─────────────────────────────────────────────
# Guards /api/orders/auto-cancel (no-show handling) and
# /api/trucks/auto-offline (clears stale live trucks). Both return 503
# without it, so an unset value silently disables both jobs.
# Vercel sends this as "Authorization: Bearer <value>".
CRON_SECRET=

# ── Admin access ────────────────────────────────────────────
# Comma-separated. Defaults to info@hottruckmap.com when unset.
ADMIN_EMAILS=